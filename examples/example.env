# Example profile. Copy to ~/.config/use-env/<name>.env and adjust.
#
# @bg / @fg: prompt colours — names (red, green, ...), 0-255, or #rrggbb.
@bg=blue
@fg=white

# Any other line is KEY=value and gets exported in the profile shell.
# $VARS and $(commands) in values are expanded; use $HOME rather than ~.
AWS_PROFILE=example
KUBECONFIG=$HOME/.kube/example.yaml
# CLOUDSDK_ACTIVE_CONFIG_NAME=example
# HCLOUD_CONTEXT=example
